##################### Provider Registry #####################
# Comma-separated keys enabled in the app / UI selector, in display order.
LLM_PROVIDERS=hermes,gemini_flash,gemini_pro,ollama_hermes3,ollama_llama3
# Used by /generate when no provider is explicitly requested.
DEFAULT_LLM_PROVIDER=gemini_flash

LLM_REQUEST_TIMEOUT_SECONDS=120
USD_TO_INR=86

##################### Hermes (self-hosted, OpenAI-compatible) #####################
HERMES_API_BASE_URL=http://192.168.68.58:8642/v1/chat/completions
HERMES_API_KEY=your_local_llm_key_here
HERMES_MODEL=hermes-agent
HERMES_INPUT_COST_PER_1K_USD=0
HERMES_OUTPUT_COST_PER_1K_USD=0

##################### Gemini (multiple model tiers, one API key) #####################
GEMINI_API_KEY=your_gemini_api_key_here

GEMINI_FLASH_MODEL=gemini-flash-latest
GEMINI_FLASH_INPUT_COST_PER_1K_USD=0.000075
GEMINI_FLASH_OUTPUT_COST_PER_1K_USD=0.0003

GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_PRO_INPUT_COST_PER_1K_USD=0.00125
GEMINI_PRO_OUTPUT_COST_PER_1K_USD=0.005

##################### Ollama (self-hosted, no API key) #####################
OLLAMA_API_BASE_URL=http://192.168.68.58:11434
OLLAMA_HERMES3_MODEL=hermes3:8b
OLLAMA_LLAMA3_MODEL=llama3:8b
OLLAMA_INPUT_COST_PER_1K_USD=0
OLLAMA_OUTPUT_COST_PER_1K_USD=0
